{
  "name": "keyvault-pwsafe",
  "version": "0.7.11",
  "description": "Passwort- und Passkey-Tresor auf Azure Key Vault mit Entra-ID-Anmeldung: Desktop-App und Browser-Erweiterung",
  "type": "module",
  "main": "desktop/main.js",
  "private": true,
  "license": "Elastic-2.0",
  "author": "Lucas Dominguez",
  "repository": "github:dominguez-posh/keyvault-pwsafe-releases",
  "scripts": {
    "start": "node scripts/start.mjs",
    "demo": "node scripts/start.mjs --demo",
    "smoke": "node scripts/start.mjs --smoke-test && node scripts/start.mjs --demo --smoke-test",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "ext:key": "node scripts/extension-key.mjs",
    "ext:pack": "node scripts/pack-extension.mjs",
    "dist": "electron-builder --win portable",
    "installer": "node scripts/release.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@azure/msal-node-extensions": "^5.5.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@simplewebauthn/server": "^14.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsqr": "1.4.0",
    "qrcode-generator": "^1.4.4"
  },
  "build": {
    "appId": "com.kvpwsafe.desktop",
    "productName": "Keevault",
    "directories": {
      "output": "release",
      "buildResources": "installer"
    },
    "files": [
      "desktop/**/*",
      "extension/core/**/*",
      "extension/styles/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Keevault",
        "schemes": [
          "kvpwsafe"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "installer/installer.nsh",
      "artifactName": "Keevault-Setup-${version}.exe"
    },
    "mac": {
      "icon": "desktop/assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Keevault-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Keevault-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "category": "Utility",
      "maintainer": "Lucas Dominguez <info@keevault.de>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Keevault-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "windows/out/KvPwSafe.PasskeyProvider.msix",
        "to": "provider/KvPwSafe.PasskeyProvider.msix"
      },
      {
        "from": "windows/out/KvPwSafe-Test.cer",
        "to": "provider/KvPwSafe-Test.cer"
      },
      {
        "from": "installer/setup.ps1",
        "to": "setup.ps1"
      }
    ],
    "appx": {
      "applicationId": "Keevault",
      "identityName": "Keevault.Desktop",
      "displayName": "Keevault",
      "publisher": "CN=KeyVault PwSafe Test",
      "publisherDisplayName": "Keevault",
      "backgroundColor": "transparent",
      "languages": [
        "de-DE",
        "en-US"
      ],
      "customManifestPath": "appxmanifest.xml",
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26200.0",
      "artifactName": "Keevault-${version}.msix"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://keevault.de/update"
      }
    ]
  }
}
