<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Keevault</displayName>
  <description>Policies for Keevault, the password and passkey manager for Azure Key Vault.</description>
  <resources>
    <stringTable>
      <string id="Keevault">Keevault</string>
      <string id="SUPPORTED_Keevault_0_6_2">Keevault 0.6.2 or later</string>
      <string id="SUPPORTED_Keevault_0_7_0">Keevault 0.7.0 or later</string>
      <string id="SUPPORTED_Keevault_0_7_10">Keevault 0.7.10 or later</string>
      <string id="Vaults">Connect vaults automatically</string>
      <string id="Vaults_Help">These Azure Key Vaults appear in Keevault for all affected users automatically after sign-in (labeled "Policy").

Name: display name of the vault, e.g. "Team IT".
Value: address of the Key Vault, e.g. https://kv-team-it.vault.azure.net – optionally with a tenant ID after a semicolon: https://kv-customer.vault.azure.net;00000000-0000-0000-0000-000000000000

Who may actually open a vault is decided by Azure: assign the users or an Entra ID group the role "Key Vault Secrets User" (read) or "Key Vault Secrets Officer" (read and write) on the Key Vault.

Computer and user policy are combined.</string>
      <string id="TenantId">Directory (tenant) for sign-in</string>
      <string id="TenantId_Help">Tenant ID or domain (e.g. contoso.onmicrosoft.com) Keevault signs in to. Not configured: the account's default directory.</string>
      <string id="ClientId">Own app registration (client ID)</string>
      <string id="ClientId_Help">Application ID of an own app registration, in case the organization blocks the default client with Conditional Access. Not configured: default sign-in without own app registration.</string>
      <string id="UnlockPrompt">Unlocking</string>
      <string id="UnlockPrompt_Help">How Keevault asks for the account when unlocking.</string>
      <string id="UnlockPrompt_SelectAccount">Confirm account (default)</string>
      <string id="UnlockPrompt_Login">Always sign in again (password/MFA)</string>
      <string id="UnlockPrompt_None">Without asking, if possible (single sign-on)</string>
      <string id="AutoLockMinutes">Lock automatically after (minutes)</string>
      <string id="AutoLockMinutes_Help">Keevault locks itself after this many minutes without input at the computer. 0 = only when the computer is locked.</string>
      <string id="ClipboardSeconds">Clear clipboard after (seconds)</string>
      <string id="ClipboardSeconds_Help">Copied passwords are removed from the clipboard after this many seconds. 0 = never.</string>
      <string id="RequirePin">Require an app PIN</string>
      <string id="RequirePin_Help">Enabled: users must set an app PIN that is asked for in addition when unlocking.</string>
      <string id="McpEnabled">Allow AI agents (MCP)</string>
      <string id="McpEnabled_Help">Enabled: connecting AI agents (Model Context Protocol, e.g. Claude or GitHub Copilot) is switched on. Each agent has to be allowed by the user once; reading passwords and changing entries is confirmed by the user in the app.

Disabled: no AI agents possible, the user cannot switch it on.

Not configured: the user decides (off by default).</string>
      <string id="OfflineMirror">Allow offline read mode</string>
      <string id="OfflineMirror_Help">Enabled: users with an app PIN may keep an encrypted mirror of their entries for the road (AES-256-GCM; opening it needs the Windows account AND the PIN). Without a network Keevault then shows the last known state – read only, no changes.

Disabled: no offline mirror, the user cannot switch the function on.

Not configured: the user decides (default: off).</string>
      <string id="UpdateMode">Updates</string>
      <string id="UpdateMode_Help">Updates of the per-user installation (EXE) from keevault.de. MSI and MSIX installations are always updated through software deployment.</string>
      <string id="UpdateMode_Off">Off – check manually only</string>
      <string id="UpdateMode_Auto">Keep up to date automatically</string>
      <string id="UpdateMode_Ask">Check at start and offer the update</string>
      <string id="SelfUpdate">Allow the app to update itself</string>
      <string id="SelfUpdate_Help">Not configured or enabled (default): Keevault checks for a new version at start and offers it; details are set by the "Updates" policy.

Disabled: Keevault never downloads or installs an update itself – not even through "Check for updates now". The app only reports that a newer version exists. Distribute updates through software deployment (MSI/MSIX or EXE) instead.

Applies to the per-user EXE installation only; MSI and MSIX never update themselves.</string>
      <string id="DefaultVault">Default vault for new entries</string>
      <string id="DefaultVault_Help">Address of the Key Vault where new entries are stored by default, e.g. https://kv-team-it.vault.azure.net. The vault should also be preset with "Connect vaults automatically". Users can then no longer change the default.</string>
      <string id="BrowserIntegration">File vaults in the browser extension</string>
      <string id="BrowserIntegration_Help">Enabled: the app registers the native messaging host for Edge, Chrome and Firefox so the browser extension can use file vaults too. Disabled: no registration, the extension sees Key Vault vaults only. Not configured: the user decides (default: on).</string>
      <string id="ExtensionIds">Allowed extension IDs</string>
      <string id="ExtensionIds_Help">IDs of the browser extensions (32 letters a–p) that may talk to the app, separated by commas. Only needed when you deploy your own extension ID; the default is the ID of the published Keevault extension.</string>
      <string id="WindowsProvider">Keevault as passkey provider in Windows</string>
      <string id="WindowsProvider_Help">Enabled: Keevault appears in the Windows passkey dialog (Windows 11). Disabled: the passkey provider is not registered. Not configured: the user decides (default: on).</string>
      <string id="SignInWindows">Sign in through the Windows dialog</string>
      <string id="SignInWindows_Help">Enabled: the Microsoft sign-in uses the Windows sign-in dialog (WAM, like PowerShell or Azure CLI) – single sign-on with the Windows account. Disabled: sign-in in the browser.</string>
      <string id="McpScope">Access for AI agents (MCP)</string>
      <string id="McpScope_Help">Which vaults AI agents may see when "Allow AI agents (MCP)" is enabled: only the vaults and folders the user released (recommended) or all vaults the user has access to.</string>
      <string id="McpScope_Selected">Released vaults and folders only</string>
      <string id="McpScope_All">All vaults of the user</string>
      <string id="Language">Language</string>
      <string id="Language_Help">Language of the user interface.</string>
      <string id="Language_Auto">Like Windows</string>
      <string id="Language_De">German</string>
      <string id="Language_En">English</string>
    </stringTable>
    <presentationTable>
      <presentation id="Vaults">
        <listBox refId="VaultsList">Vaults (name = display name, value = Key Vault address)</listBox>
      </presentation>
      <presentation id="TenantId">
        <textBox refId="TenantId"><label>Tenant ID or domain</label></textBox>
      </presentation>
      <presentation id="ClientId">
        <textBox refId="ClientId"><label>Application (client) ID</label></textBox>
      </presentation>
      <presentation id="UnlockPrompt">
        <dropdownList refId="UnlockPrompt" noSort="true" defaultItem="0">Unlocking</dropdownList>
      </presentation>
      <presentation id="AutoLockMinutes">
        <decimalTextBox refId="AutoLockMinutes" defaultValue="15">Minutes</decimalTextBox>
      </presentation>
      <presentation id="ClipboardSeconds">
        <decimalTextBox refId="ClipboardSeconds" defaultValue="30">Seconds</decimalTextBox>
      </presentation>
      <presentation id="UpdateMode">
        <dropdownList refId="UpdateMode" noSort="true" defaultItem="0">Updates</dropdownList>
      </presentation>
      <presentation id="DefaultVault">
        <textBox refId="DefaultVault"><label>Key Vault address</label></textBox>
      </presentation>
      <presentation id="ExtensionIds">
        <textBox refId="ExtensionIds"><label>Extension IDs (comma separated)</label></textBox>
      </presentation>
      <presentation id="McpScope">
        <dropdownList refId="McpScope" noSort="true" defaultItem="0">Access</dropdownList>
      </presentation>
      <presentation id="Language">
        <dropdownList refId="Language" noSort="true" defaultItem="0">Language</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
